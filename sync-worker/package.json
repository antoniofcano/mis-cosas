{
  "name": "patron-sync",
  "version": "1.1.0",
  "private": true,
  "description": "Sincronización del progreso de la app Patrón entre los aparatos de un alumno y su recordatorio diario (Cloudflare Worker + D1)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --local --port 4810",
    "db:local": "wrangler d1 migrations apply patron-sync --local",
    "vapid": "node scripts/vapid.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20260923.0-alpha",
    "wrangler": "4.140.0"
  }
}
